# ==============================================================================
# INTEGRATED SPACE WEATHER MONITORING & SATELLITE OPERATIONS DECISION SUPPORT
# System Configuration (.env)
# ==============================================================================

# API Gateway Configuration
GATEWAY_PORT=8080

# Main Backend Configuration
MAIN_BACKEND_PORT=8081
MAIN_BACKEND_URL=http://localhost:8081
WS_PORT=8085
WS_TARGET_URL=ws://localhost:8085

# Simulation Service Configuration
SIMULATION_PORT=8082
SIMULATION_SERVICE_URL=http://localhost:8082
SIMULATION_WORKER_COUNT=2
SIMULATION_INTERVAL=15
SIMULATION_FALLBACK=true

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=spaceweather_db
DB_USER=spaceweather
DB_PASSWORD=spaceweather123
DB_ROOT_PASSWORD=root
DB_URL=jdbc:mysql://localhost:3306/spaceweather_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_MAX_POOL_SIZE=10

# Local LLM (Ollama) Configuration
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
DETERMINISTIC_FALLBACK=true

# Persistent Semantic Memory Store
VECTOR_STORE_PATH=./data/memory
